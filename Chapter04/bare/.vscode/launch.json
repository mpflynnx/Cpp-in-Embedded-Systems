{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug application in Renode",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "Run Renode Debug",
            "postDebugTask": "Close Renode",
            "servertype": "external",
            "gdbPath": "E:/Arm/GNU-Toolchain-mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            "gdbTarget": "localhost:3333",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/bare.elf",
            "preLaunchCommands": [
                "monitor machine Reset",
                "monitor start",
                "monitor continue"
            ]
        },
        {
            "name": "Run application without debugging",
            "type": "cortex-debug",
            "request": "launch",
            "noDebug": true,
            "preLaunchTask": "Run Renode",
            "postDebugTask": "Close Renode",
            "servertype": "external",
            "gdbPath": "E:/Arm/GNU-Toolchain-mingw-w64-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            "gdbTarget": "localhost:3333",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/bare.elf"
        }
    ]
}

